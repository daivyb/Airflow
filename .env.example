# =============================================================
# Plantilla de Variables de Entorno - Profonanpe ETL Airflow
# Copia este archivo a .env y completa con las credenciales reales
# =============================================================

# Conexiones de Base de Datos
# Formato: mssql+pymssql://<usuario>:<password>@<host>:<puerto>/<base_de_datos>
AIRFLOW_CONN_SQLSERVER_ORIGEN=mssql+pymssql://usuario_db:password_db@host.docker.internal:1433/ProfonanpeOrigen
AIRFLOW_CONN_SQLSERVER_DW=mssql+pymssql://usuario_db:password_db@host.docker.internal:1433/ProfonanpeDW

# Credenciales de sistema 2
AIRFLOW_VAR_VTRACK_USER=usuario@profonanpe.org.pe
AIRFLOW_VAR_VTRACK_PASS=tu_password_aqui
AIRFLOW_VAR_VTRACK_URL=https://profonanpe.vtrack.cl
