# =============================================================================
# Environment Variables Template: Financial Data Warehouse Airflow Stack
# Copy this file to .env and populate with your target environment values.
# Note: In Docker Compose .env files, escape literal '$' characters as '$$'.
# =============================================================================

# Airflow Metadata Database (PostgreSQL)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=airflow
POSTGRES_PORT=5432

# Airflow Webserver Admin Account & Encryption Key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
AIRFLOW_ADMIN_EMAIL=data-engineering@example.org
AIRFLOW_WEBSERVER_PORT=8080
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# SQL Server Connections (format: mssql+pymssql://<user>:<password>@<host>:<port>/<database>)
# Use host.docker.internal for local development against a Windows/macOS host instance.
AIRFLOW_CONN_SQLSERVER_SOURCE=mssql+pymssql://etl_service_user:change_me_db@host.docker.internal:1433/FinancialSourceDB
AIRFLOW_CONN_SQLSERVER_DW=mssql+pymssql://etl_service_user:change_me_db@host.docker.internal:1433/FinancialDW

# Grant Management Portal Extractor Configuration
AIRFLOW_VAR_PORTAL_URL=https://grants-portal.example.org
AIRFLOW_VAR_PORTAL_USER=etl-bot@example.org
AIRFLOW_VAR_PORTAL_PASS=change_me_portal
AIRFLOW_VAR_PORTAL_LOGIN_PATH=/users/sign_in
AIRFLOW_VAR_PORTAL_REPORT_PATH=/entities/catalog

# ETL Pipeline Business Parameters
AIRFLOW_VAR_SOURCE_TABLE=dbo.FinanzasProyectos
# Comma-separated 3-digit umbrella project codes promoted to 6-digit donor-level records
AIRFLOW_VAR_SPLIT_PROJECT_CODES=900
